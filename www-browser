#!/usr/bin/env bash

# www-browser — open URLs via exec-server
# Install on a remote machine to forward browser opens to your local Mac

HOST="${EXEC_SERVER_HOST:-127.0.0.1}"
PORT="${EXEC_SERVER_PORT:-7771}"
EXEC_SERVER_URL="http://${HOST}:${PORT}/exec"

if [ -z "${1:-}" ]; then
  echo "Usage: www-browser <url>"
  echo ""
  echo "Opens a URL on the machine running exec-server."
  echo "Configure with EXEC_SERVER_HOST and EXEC_SERVER_PORT env vars."
  exit 1
fi

ENCODED_URL=$(printf '%s' "$1" | jq -sRr @uri)
COMMAND="open \"$ENCODED_URL\""
ENCODED_COMMAND=$(printf '%s' "$COMMAND" | jq -sRr @uri)

curl -s "${EXEC_SERVER_URL}?command=${ENCODED_COMMAND}"
echo
