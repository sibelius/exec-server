# exec-server configuration
# Copy to .env and modify as needed

# Port to listen on (default: 7771)
# EXEC_SERVER_PORT=7771

# Host/interface to bind to (default: 127.0.0.1)
# EXEC_SERVER_HOST=127.0.0.1

# Command execution timeout in milliseconds (default: 30000)
# EXEC_SERVER_TIMEOUT=30000

# Path to Node.js binary (auto-detected if not set)
# EXEC_SERVER_NODE=/usr/local/bin/node
